APP_NAME=unrestricted-ai-backend
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql://aiuser:aipass@localhost:5432/aidb
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
UPLOAD_MAX_SIZE=5000000000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-outputs

USE_GPU=true
GPU_DEVICE=0
GPU_MEMORY_FRACTION=0.95

DIFFUSION_MODEL=stabilityai/stable-diffusion-xl-base-1.0
REALVIS_MODEL=SG161222/RealVisXL_V4.0
IMG2IMG_STRENGTH=0.75
INPAINT_PADDING=32
UPSCALE_FACTOR=4

VIDEO_MODEL=animatediff
VIDEO_FPS=24
VIDEO_DURATION_MAX=60
MOCHI_MODEL=genmo/mochi-1
GROK_API_KEY=

FACE_SWAP_METHOD=roop
DEEPFACE_LIVE_ENABLED=true
FACE_DETECTION_MODEL=retinaface
FACE_RECOGNITION_MODEL=insightface
BLEND_RATIO=0.5

NERF_BACKEND=nerfstudio
NERF_RESOLUTION=512
NERF_TRAIN_STEPS=10000

LLM_PROVIDER=local
LLM_MODEL=llama3
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

HF_TOKEN=
HF_CACHE_DIR=./models/huggingface

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

JOB_TIMEOUT=3600
JOB_RETRY_COUNT=3
MAX_QUEUE_SIZE=1000

API_TITLE=Unrestricted AI Platform
API_VERSION=1.0.0
CORS_ORIGINS=*

JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
